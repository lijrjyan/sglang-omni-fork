+
+
+class TestEncoderDecoderSpecKV(CustomTestCase):
+    def test_cross_attention_verify_plan_has_encoder_keys_and_decoder_queries(self):
+        from sglang.srt.layers.attention.flashinfer_backend import (
+            FlashInferIndicesUpdaterPrefill,
+        )
+
+        calls = []
+        updater = SimpleNamespace(
+            prefill_wrapper_ragged=None,
+            kv_indptr=[None, None],
+            qo_indptr=[None, None],
+            call_begin_forward=lambda *args, **kwargs: calls.append((args, kwargs)),
+        )
+        spec = SimpleNamespace(num_tokens_per_req=4)
+        FlashInferIndicesUpdaterPrefill.update_cross_attention(
+            updater,
+            torch.tensor([0, 1]),
+            torch.tensor([5, 8]),
+            torch.tensor([5, 8]),
+            13,
+            None,
+            ["self", "cross"],
+            False,
+            torch.tensor([1500, 1200]),
+            [1500, 1200],
+            spec,
+        )
+        self_plan, cross_plan = calls
+        self.assertIs(self_plan[0][11], spec)
+        self.assertIsNone(cross_plan[0][11])
+        self.assertEqual(self_plan[0][7].tolist(), [1500, 1200])
+        self.assertEqual(cross_plan[0][3].tolist(), [1500, 1200])
+        self.assertEqual(cross_plan[1]["query_lens"].tolist(), [4, 4])
+        self.assertEqual(cross_plan[1]["seq_lens_cpu"], [1500, 1200])
+        self.assertEqual(self_plan[1]["seq_lens_cpu"], [9, 12])
+
+    def test_verify_attention_reads_decoder_suffix_of_each_request(self):
+        from sglang.srt.speculative.eagle_info import EagleVerifyInput
+
+        # Execute the real metadata builder with the GPU gather replaced by
+        # its CPU equivalent. Distinct request rows expose offset/row mistakes.
+        class GatherIndices:
+            def __getitem__(self, grid):
+                def gather(table, rows, lengths, indptr, starts, out, stride):
+                    for i, row in enumerate(rows.tolist()):
+                        start = 0 if starts is None else int(starts[i])
+                        out[int(indptr[i]) : int(indptr[i + 1])] = table[
+                            row, start : start + int(lengths[i])
+                        ]
+
+                return gather
+
+        table = torch.arange(60, dtype=torch.int32).reshape(3, 20)
+        verify = SimpleNamespace(
+            draft_token_num=3, custom_mask=torch.ones(100, dtype=torch.bool)
+        )
+        with patch(
+            "sglang.srt.speculative.eagle_info.create_flashinfer_kv_indices_triton",
+            GatherIndices(),
+        ):
+            for encoder_lens in (torch.tensor([5, 3]), None):
+                indices, kv_ptr, qo_ptr, _ = EagleVerifyInput.generate_attn_arg_prefill(
+                    verify,
+                    torch.tensor([2, 0]),
+                    torch.tensor([2, 4]),
+                    6,
+                    table,
+                    kv_start_idx=encoder_lens,
+                )
+                expected = (
+                    [45, 46, 47, 48, 49, 3, 4, 5, 6, 7, 8, 9]
+                    if encoder_lens is not None
+                    else [40, 41, 42, 43, 44, 0, 1, 2, 3, 4, 5, 6]
+                )
+                self.assertEqual(indices.tolist(), expected)
+                self.assertEqual(kv_ptr.tolist(), [0, 5, 12])
+                self.assertEqual(qo_ptr.tolist(), [0, 3, 6])
+
+    def test_unshifted_worker_consumes_bonus_at_decoder_positions(self):
+        from sglang.srt.speculative.eagle_worker_v2 import EagleDraftWorker
+
+        calls = []
+
+        def forward(batch):
+            calls.append(
+                (
+                    batch.input_ids.clone(),
+                    batch.positions.clone(),
+                    batch.out_cache_loc.clone(),
+                )
+            )
+            logits = torch.zeros((2, 16))
+            logits.scatter_(1, (batch.input_ids.long() + 1).reshape(-1, 1), 1)
+            return SimpleNamespace(
+                logits_output=SimpleNamespace(next_token_logits=logits)
+            )
+
