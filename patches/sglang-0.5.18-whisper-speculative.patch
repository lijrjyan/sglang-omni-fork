+    def test_verify_write_and_rollback_never_touch_encoder_slots(self) -> None:
+        encoder_len = 3
+        decoder_len = 2
+        draft_token_num = 4
+        row = ["encoder-0", "encoder-1", "encoder-2", "decoder-0", "decoder-1"]
+        row.extend(["reserved"] * draft_token_num)
+
+        write_start, write_end = physical_kv_range(
+            decoder_len,
+            decoder_len + draft_token_num,
+            encoder_len,
+        )
+        row[write_start:write_end] = [
+            f"draft-{index}" for index in range(draft_token_num)
+        ]
+
+        committed_decoder_len = decoder_len + 2
+        rollback_start, rollback_end = physical_kv_range(
+            committed_decoder_len,
+            decoder_len + draft_token_num,
+            encoder_len,
+        )
+        del row[rollback_start:rollback_end]
+
+        assert row[:encoder_len] == ["encoder-0", "encoder-1", "encoder-2"]
+        assert row[encoder_len:] == ["decoder-0", "decoder-1", "draft-0", "draft-1"]
