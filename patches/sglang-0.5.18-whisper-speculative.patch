+++ b/python/sglang/srt/speculative/encoder_decoder_utils.py
@@ -0,0 +1,221 @@
+from __future__ import annotations
+
+from typing import Any, NamedTuple, Optional, Sequence, Tuple
+
+
+class UnshiftedDraftReplayMetadata(NamedTuple):
+    decoder_lens_cpu: tuple[int, ...]
+    encoder_lens_cpu: tuple[int, ...]
+    step_decoder_lens_cpu: tuple[tuple[int, ...], ...]
+    step_position_deltas: tuple[int, ...]
+    out_cache_loc_numel: int
+
+
+def encoder_cached_for_graph(
+    encoder_cached: Optional[Sequence[bool]], batch_size: int
+) -> bool:
+    """Return whether every live encoder-decoder row can reuse cached cross K/V."""
+    return (
+        encoder_cached is not None
+        and len(encoder_cached) == batch_size
+        and all(encoder_cached)
+    )
+
+
+def encoder_lens_fit_graph(
+    encoder_lens_cpu: Optional[Sequence[int]],
+    batch_size: int,
+    max_encoder_len: int,
+) -> bool:
+    """Return whether live encoder lengths fit the captured source capacity."""
+    return (
+        max_encoder_len > 0
+        and encoder_lens_cpu is not None
+        and len(encoder_lens_cpu) == batch_size
+        and all(0 < int(value) <= max_encoder_len for value in encoder_lens_cpu)
+    )
+
+
+def pad_encoder_lens_cpu(
+    encoder_lens_cpu: Optional[Sequence[int]],
+    padded_batch_size: int,
+    fill_value: int,
+) -> Optional[list[int]]:
+    """Pad host encoder lengths without reading a device tensor during replay."""
+    if encoder_lens_cpu is None:
+        return None
+    if len(encoder_lens_cpu) > padded_batch_size:
+        raise ValueError(
+            "encoder_lens_cpu exceeds padded batch size: "
+            f"{len(encoder_lens_cpu)} > {padded_batch_size}"
+        )
+    return [int(value) for value in encoder_lens_cpu] + [fill_value] * (
+        padded_batch_size - len(encoder_lens_cpu)
+    )
+
+
+def step_decoder_lens_cpu(
+    decoder_lens_cpu: Sequence[int], step_delta: int
+) -> list[int]:
+    """Build host-known decoder KV lengths for an unshifted draft step."""
+    return [int(value) + step_delta for value in decoder_lens_cpu]
+
+
+def prepare_unshifted_draft_replay(
+    *,
+    decoder_lens_cpu: Sequence[int],
+    encoder_lens_cpu: Sequence[int],
+    padded_batch_size: int,
+    decoder_fill_value: int,
+    encoder_fill_value: int,
+    topk: int,
+    num_steps: int,
+) -> UnshiftedDraftReplayMetadata:
+    """Build all host-known metadata refreshed before an unshifted draft replay."""
+    raw_batch_size = len(decoder_lens_cpu)
+    if len(encoder_lens_cpu) != raw_batch_size:
+        raise ValueError(
+            "decoder/encoder host length counts differ: "
+            f"{raw_batch_size} != {len(encoder_lens_cpu)}"
+        )
+    if raw_batch_size > padded_batch_size:
+        raise ValueError(
+            "live draft batch exceeds padded batch size: "
+            f"{raw_batch_size} > {padded_batch_size}"
+        )
+
+    decoder_lens = tuple(int(value) for value in decoder_lens_cpu) + (
+        int(decoder_fill_value),
+    ) * (padded_batch_size - raw_batch_size)
+    encoder_lens = tuple(int(value) for value in encoder_lens_cpu) + (
+        int(encoder_fill_value),
+    ) * (padded_batch_size - raw_batch_size)
+    step_lens = tuple(
+        tuple(step_decoder_lens_cpu(decoder_lens, step + 1))
+        for step in range(num_steps)
+    )
+    return UnshiftedDraftReplayMetadata(
+        decoder_lens_cpu=decoder_lens,
+        encoder_lens_cpu=encoder_lens,
+        step_decoder_lens_cpu=step_lens,
+        step_position_deltas=tuple(range(num_steps)),
+        out_cache_loc_numel=draft_replay_out_cache_loc_numel(
+            raw_batch_size, topk, num_steps
+        ),
+    )
+
+
+def draft_decode_full_plan_wrapper_flags(
+    num_wrappers: int, *, is_encoder_decoder_draft: bool
+) -> tuple[bool, ...]:
+    """Select wrappers that need FlashInfer's complete replay-time plan refresh."""
+    return (bool(is_encoder_decoder_draft),) * num_wrappers
+
+
+def prefill_custom_mask_wrapper_flags(
+    use_custom_mask: bool,
+    num_wrappers: int,
+    *,
+    is_cross_attention: bool,
+) -> tuple[bool, ...]:
+    """Select which prefill graph wrappers own packed custom-mask buffers.
+
+    Encoder-decoder TARGET_VERIFY uses the tree mask only for decoder
+    self-attention.  Its second wrapper is plain cross-attention and must not be
+    switched into FlashInfer's custom-mask mode merely because wrapper zero is.
+    """
+    flags = [bool(use_custom_mask)] * num_wrappers
+    if use_custom_mask and is_cross_attention and num_wrappers > 1:
+        flags[1] = False
+    return tuple(flags)
+
+
+def target_verify_fast_prefill_wrapper_flags(
+    num_wrappers: int,
+    *,
+    is_cross_attention: bool,
+) -> tuple[bool, ...]:
+    """Keep the fast target-verify plan off the mask-owning self wrapper."""
+    flags = [False] * num_wrappers
+    if is_cross_attention and num_wrappers > 1:
+        flags[1] = True
+    return tuple(flags)
+
+
+def cross_attention_kv_indices_buffer_width(
+    default_width: int,
+    batch_size: int,
+    max_source_positions: int,
+) -> int:
+    """Return a graph buffer width that can hold every encoder-prefix index."""
+    return max(int(default_width), int(batch_size) * int(max_source_positions))
+
+
+def draft_replay_out_cache_loc_numel(
+    batch_size: int,
+    topk: int,
+    num_steps: int,
+) -> int:
+    """Number of physical draft write locations copied before graph replay."""
+    return int(batch_size) * int(topk) * int(num_steps)
+
+
+def physical_kv_base(decoder_seq_lens: Any, encoder_lens: Optional[Any]) -> Any:
+    """Return request-table offsets without changing decoder-logical lengths."""
+    if encoder_lens is None:
+        return decoder_seq_lens
+    return encoder_lens + decoder_seq_lens
+
+
+def physical_kv_range(
+    decoder_start: Any,
+    decoder_end: Any,
+    encoder_lens: Optional[Any],
+) -> Tuple[Any, Any]:
+    return (
+        physical_kv_base(decoder_start, encoder_lens),
+        physical_kv_base(decoder_end, encoder_lens),
+    )
+
+
+def use_spec_attention_plan(
+    is_encoder_decoder: bool,
+    is_cross_attention: bool,
+    has_spec_info: bool,
+) -> bool:
+    """Keep tree/chain plans off encoder-decoder cross-attention wrappers."""
+    return has_spec_info and not (is_encoder_decoder and is_cross_attention)
+
+
+def use_unshifted_standalone_layout(
+    is_standalone: bool, is_encoder_decoder: bool
+) -> bool:
+    """Return whether the independent draft must match target decoder positions."""
+    return is_standalone and is_encoder_decoder
+
+
+def spec_draft_forward_count(
+    num_steps: int, is_standalone: bool, is_encoder_decoder: bool
+) -> int:
+    if use_unshifted_standalone_layout(is_standalone, is_encoder_decoder):
+        return num_steps
+    return max(num_steps - 1, 0)
+
+
+def spec_draft_extend_decoder_start(
+    decoder_seq_len: Any, is_standalone: bool, is_encoder_decoder: bool
+) -> Any:
+    if use_unshifted_standalone_layout(is_standalone, is_encoder_decoder):
+        return decoder_seq_len + 1
+    return decoder_seq_len
+
+
+def spec_draft_prefill_tokens(
+    input_ids: Tuple[int, ...],
+    tail_token: int,
+    is_standalone: bool,
+    is_encoder_decoder: bool,
+) -> Tuple[int, ...]:
+    if use_unshifted_standalone_layout(is_standalone, is_encoder_decoder):
+        return input_ids
+    return input_ids[1:] + (tail_token,)
